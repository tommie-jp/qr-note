{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/**/*.{ts,mjs,cjs}",
    "e2e/**/*.ts",
    "public/sw.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs,cjs}",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "src/generated/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@prisma/client",
    "onnxruntime-node",
    "zxing-wasm",
    "dompurify",
    "client-only",
    "@tailwindcss/typography",
    "tailwindcss",
    "jscpd"
  ]
}
