# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
/src/generated/

# Docker の依存レイヤー用に版を潰した package.json / package-lock.json の写し。
# scripts/writeDepsManifest.mjs が生成する派生物 (docs/80-デプロイ再高速化計画.md)
/.deps/

# .env.example はコミットする
!.env.example

# uploaded images (dev)
/data/

# doCopyDBfromVPS2.sh がローカル DB を上書きする前に取る退避ダンプ。
# 本番の実データ (メモ・画像) を含むため git 管理外
/backup/

# node-tikzjax の webfont (scripts/copyTikzFonts.mjs が node_modules から複製する)
/public/tikzjax

# スキャナの読み取りエンジン (scripts/copyZxingWasm.mjs が node_modules から複製する)
/public/zxing

# OCR 推論エンジンの wasm (scripts/copyOnnxWasm.mjs が node_modules から複製する)
/public/onnxruntime

# 画像検索 (transformers.js) の onnxruntime-web wasm
# (scripts/copyEmbeddingWasm.mjs が node_modules から複製する)
/public/embedding-onnx

# OCR の認識モデル (scripts/fetchPaddleOcrModels.mjs がネットから落とす)
/public/paddle-ocr

# PDF ビューア (scripts/copyPdfjsAssets.mjs が node_modules から複製する)
/public/pdfjs
