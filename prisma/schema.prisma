generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Ver1 (MongoDB) の item コレクションを引き継ぐ。
// itemNo は Ver1 の実データが文字列のため文字列主キー
// (印刷済み QR シールの URL 互換を最優先)。
// itemNoNum は数値ソート用 (非数字の itemNo は null)。
model Item {
  itemNo    String   @id @map("item_no")
  itemNoNum Int?     @map("item_no_num")
  memo      String   @default("")
  url       String   @default("")
  mode      Mode     @default(memo)
  // memo の先頭行から Markdown 記法を剥がした見出しの派生キャッシュ
  // (docs/63-タイトル順計画.md)。一覧のタイトル順で ORDER BY に使う。
  //
  // 表示は今までどおり memoSummary() をその場で通す (この列は読まない)。
  // 正本は memo で、保存のたびに作り直す点は tags / props と同じ。
  // **列を足したのは並べ替えのため** — 見出しの切り出しは Markdown の解析
  // (コードフェンス・折りたたみ・行頭記法) が要り、SQL では書けない。
  //
  // 索引は張らない。数百件の seq scan + sort で足りる (task_todo と同じ判断)。
  title     String   @default("")
  // memo から抽出したタグ (正規化済み) の派生キャッシュ。検索・補完に使う。
  tags      String[] @default([])
  // memo のプロパティ行 (hFE=208 など) から抽出した派生キャッシュ。
  // [{ key, label, value }] の配列でタグ検索時の特性表に使う (src/lib/props.ts)。
  props     Json     @default("[]")
  // memo のタスクリスト (`- [ ]` / `- [x]`) の個数の派生キャッシュ
  // (docs/56-チェック検索計画.md)。検索の is:todo / is:done で使う。
  // tags / props と同じく正本はメモ本文で、保存のたびに数え直す。
  //
  // 読むのは今のところ `> 0` だけ (is:todo / is:done)。それでも真偽値にせず
  // 個数で持つのは、残数表示や残りの多い順の並べ替えを後から足せるようにする
  // ため。int と bool で保存量は変わらない。
  // 索引は張らない — 現状の規模では整数比較 1 つが増えるだけ。
  taskTodo  Int      @default(0) @map("task_todo")
  taskDone  Int      @default(0) @map("task_done")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // 最後にこのノートを開いた日時 (docs/37-アクセス順計画.md)。
  // ログイン中に /item・/edit を開いたときだけ進む。
  //
  // **updated_at と分けて持つのが要点**。「見ただけで更新順が動く」のは嘘に
  // なる (trashItems / setItemPublic が生 SQL で @updatedAt を避けているのと
  // 同じ考え方)。一方で ENEX から取り込んだノートは作成・更新日時が Evernote
  // 由来 (2012 年など) なので更新順では埋もれる。この列があると「最近触った
  // 順」で拾えて、取り込んだ日時も本文の日時も両方を正直に保てる。
  //
  // 既存行は移行時に updated_at で埋めた。null 許容にしないのは、並べ替えで
  // NULLS LAST の考慮が要らないため (初期値があれば最初は更新順と同じに
  // 見え、使うほどアクセス順に育つ)。
  accessedAt DateTime @default(now()) @map("accessed_at")
  // ゴミ箱 (二段階削除)。null = 通常、非 null = ゴミ箱行き日時。
  // 検索・タグ集計は null の行だけを見る。永久削除は行の DELETE。
  // ゴミ箱の行も items に残るため、nextItemNo の採番はその番号を
  // 自然に飛ばす (= 復元まで番号が予約される。docs/12-ゴミ箱計画.md §4)。
  deletedAt DateTime? @map("deleted_at")
  // 公開 (docs/22-ノート公開計画.md)。null = 非公開、非 null = 公開した日時。
  // 非 null のノートだけが、ログインしていない人にも /item/<itemNo> で開ける。
  // 判定の正本は src/lib/publicItem.ts の isPublicItem() で、ゴミ箱 (deleted_at
  // 非 null) の行はここが非 null でも公開しない。
  publicAt  DateTime? @map("public_at")
  // 「オフラインで常に使う」印 (docs/65-オフライン対応計画.md §7)。
  // true のノートは、本文だけでなく添付の原寸・回路図・シークレット断片まで
  // 端末へ持ち出す。
  //
  // **端末ごとではなくノートごとに持つ**。単独ユーザーの前提では「スマホで
  // 印を付けたノートは PC でも持ち出される」ほうが期待に合い、端末を増やす
  // たびに付け直す手間も要らない。端末ごとの容量差は、持ち出す側 (sync) が
  // 保存に失敗したときに断ることで吸収する。
  //
  // 索引は張らない。同期は全件を 1 クエリで引くので絞り込みに使わない
  // (task_todo / title と同じ判断)。
  offlinePin Boolean @default(false) @map("offline_pin")

  @@index([itemNoNum])
  @@index([tags], type: Gin)
  @@map("items")
}

enum Mode {
  memo
  url
}

// memo に挿入した画像。ファイルシステム (volume) ではなく DB に持つことで、
// pg_dump だけでメモと画像が一緒に取れ、両者の整合が壊れないようにする。
// name は Ver2.x で発番済みの "UUID.拡張子" をそのまま引き継ぐ
// (既存メモ内の /api/images/<name> リンクを壊さないため)。
model Image {
  name      String   @id
  mime      String
  data      Bytes
  // 一覧のサムネイル (docs/23-検索結果表示モード計画.md §2)。data から作れる
  // 派生キャッシュで、形式は常に THUMB_MIME (src/lib/thumbnail.ts)。
  // null = 未生成。原寸のまま一覧に並べるとスマホ写真 1 枚が数 MB になるため、
  // 保存時に 1 度だけ作って持つ。null のときは配信側が原寸で代替するので、
  // 生成に失敗しても画像が割れることはない (遅くなるだけ)。
  thumb     Bytes?
  // 画像検索用の埋め込みベクトル (docs/25-画像検索計画.md §4)。data から作れる
  // 派生キャッシュで、Float32Array (正規化済み) をそのままバイト列にしたもの。
  // 形式・次元はモデルに従う (src/lib/embedding/model.ts の EMBEDDING_DIM)。
  // null = 未生成。thumb と同じく生成に失敗しても保存は成功させ、画像検索の
  // 対象から外れるだけにする。既存行は scripts/backfillEmbeddings.mjs で埋める。
  embedding Bytes?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("images")
}

// 登録済みパスキー (docs/29-パスキー計画.md §5)。
// 持つのは**公開鍵だけ**で、秘密鍵は端末 (Secure Enclave / iCloud キーチェーン)
// から出てこない。この表が漏れても成りすませない。
model WebAuthnCredential {
  // credential ID。認証器が振る識別子で、base64url 文字列のまま持つ
  id         String   @id
  // 登録した時点の利用者名。いまは 1 名だけ (docs/29 §11) だが、ログイン後に
  // ヘッダの帯へ出す名前をここから取ることで、env を後から変えても
  // 発行済みのパスキーが誰のものか分からなくなることがない
  userName   String   @map("user_name")
  publicKey  Bytes    @map("public_key")
  // 認証器が「何回使われたか」を申告する値。クローン検知に使うが、
  // 巻き戻りで即失効はさせない (docs/29 §9)。WebAuthn の仕様上 uint32 なので
  // Int (符号付き 32bit) では上半分が入らない。BigInt で持ち、
  // SimpleWebAuthn へ渡すときだけ Number() に落とす
  counter    BigInt   @default(0)
  // 認証器の接続手段 ('internal', 'hybrid' など)。次回ログイン時に
  // ブラウザへ返すと、どの手段で聞きに行くかの案内が正確になる
  transports String[] @default([])
  // 一覧で見分けるための名前 (「iPhone」など)。人が付ける
  label      String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  // シークレットのマスターキーを、このパスキーの PRF 由来の鍵 (KEK) で
  // 包んだもの (docs/51-部分暗号化計画.md §6)。null = この端末ではまだ
  // 暗号化を有効にしていない。
  //
  // **サーバにあるのは包んだ後だけ**。開けるのは認証器 (Face ID) を持つ
  // 本人だけで、この列が丸ごと漏れても中身は取り出せない。パスキーを消せば
  // この列も一緒に消える (鍵の後始末を別に書かなくてよい)。
  secretKeyWrap Bytes? @map("secret_key_wrap")

  @@map("webauthn_credentials")
}

// シークレット断片 (docs/51-部分暗号化計画.md §4)。
//
// **中身はクライアントが暗号化したバイト列だけ**。サーバは鍵を持たないので
// 復号できず、pg_dump が漏れても読めない。画像と同じく DB に置くことで、
// バックアップ 1 本でメモと断片が揃う (整合が壊れない)。
//
// **images テーブルには入れない**のが要点。saveImage() を通すとサムネと
// 埋め込みが自動生成され、平文由来の派生物がサーバに残ってしまう
// (docs/51 §5)。表を分けてパイプラインごと分離する。
model Secret {
  // サーバが振った UUID。画像と違い拡張子を持たない (isValidSecretName)
  name      String   @id
  // 復号後の中身の種別。断片本文は text/markdown、断片内の画像は image/*。
  // **暗号化しないメタデータ**で、管理者には「これは画像だ」までは見える
  // (docs/51 §1 の割り切り)。表示側が復号後の描き分けに使う
  mime      String
  // 暗号エンベロープ (version || iv || AES-256-GCM。src/lib/secretEnvelope.ts)
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("secrets")
}

// 鍵束の検証値 (docs/51-部分暗号化計画.md §6)。行は 1 つだけ (id = 1)。
//
// マスターキーそのものは**どこにも保存しない**。ここにあるのは「その鍵で
// 合っているか」を確かめるためだけの既知平文の暗号文で、復旧キーを打ち込んだ
// ときの検算に使う (断片が 1 つも無くても確かめられるようにするため)。
// 行の有無が「暗号化を設定済みか」の判定にもなる。
model SecretKeyring {
  id        Int      @id @default(1)
  verifier  Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("secret_keyring")
}

// ログイン中の端末 (docs/29-パスキー計画.md §4)。
//
// 生のトークンはブラウザの Cookie にしか存在せず、ここには sha256 だけを置く。
// pg_dump が漏れてもセッションを乗っ取れないようにするため
// (パスワードのハッシュを env に持つのと同じ考え方)。
model Session {
  tokenHash String   @id @map("token_hash")
  // 利用者名。いまは BASIC_AUTH_USER の 1 名だけだが、ヘッダの帯に出す名前は
  // セッション自身が持つ (env を後から変えても、発行済みの帯が化けない)
  userName  String   @map("user_name")
  createdAt DateTime @default(now()) @map("created_at")
  // 90 日のスライディング。使うたびに延びる (延長は 1 日 1 回まで。docs/29 §4)
  expiresAt DateTime @map("expires_at")

  // 期限切れの掃除で範囲削除するため
  @@index([expiresAt])
  @@map("sessions")
}

// memo の ```circuitikz フェンスから描いた SVG のキャッシュ。
// 描画は TeX (WASM) の起動込みで 1 秒強かかる一方、memo は何度も表示され
// 内容はめったに変わらないため、本文のハッシュで引けるようにする。
// hash は sha256(レンダラ版 + ソース) で、レンダラ版を混ぜることで
// 描画結果が変わったときに古い SVG を返し続けないようにしている。
// 画像と同じく DB に置くことで pg_dump だけで丸ごと復元できる
// (消えても再描画できる派生キャッシュなので、消失しても実害はない)。
model CircuitSvg {
  hash      String   @id
  svg       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("circuit_svgs")
}

// 検索窓が覚えているクエリ (docs/59-検索候補計画.md §7)。
//
//   kind = 'recent' … 直近に検索した語。使うほど勝手に入れ替わる
//   kind = 'saved'  … ☆ で自分が登録した検索式
//
// **もとは localStorage に置いていた**。端末ごとに違ってよいと考えていたが、
// 実際には同じ人が iPhone と PC を行き来するので、登録パターンを片方で作っても
// もう片方に無いのが不便だった。書き込みの契機は「意思表示」のときだけ
// (打鍵ごとの検索からは呼ばない) なので、DB に置いても頻度は高くない。
//
// **1 クエリ = 1 行**。JSON を 1 列に持つと、2 台から同時に登録したときに
// 後から書いたほうが相手の登録を消してしまう。行に割ると衝突する範囲が
// そのクエリだけで済む。
//
// userName で仕切るのが要点 — 履歴は「その人が何を探しているか」そのもので、
// 利用者が増えたときに混ざってはいけない。Session / WebAuthnCredential と
// 同じく、User 表は作らず名前の文字列で持つ (docs/29 §11)。
model SearchQuery {
  id       Int    @id @default(autoincrement())
  userName String @map("user_name")
  kind     String
  query    String
  // 最近使った順に並べるための時刻。@updatedAt にはしない —
  // 「使った」以外の理由で行を触ったときに順が動いてほしくないので、
  // 動かす場所を書き手が明示する
  usedAt DateTime @default(now()) @map("used_at")

  // 同じ人の同じ種類に同じクエリは 1 行だけ。upsert の当て先でもある
  @@unique([userName, kind, query])
  // 一覧は必ず「その人の分を最近使った順で」引く
  @@index([userName, usedAt])
  @@map("search_queries")
}
