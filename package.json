{
  "name": "ver2",
  "version": "0.23.13",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run copy:assets && next dev",
    "build": "npm run copy:assets && prisma generate && next build",
    "copy:assets": "node scripts/assets.mjs",
    "backfill:embeddings": "tsx --conditions=react-server scripts/backfillEmbeddings.ts",
    "backfill:git": "tsx --conditions=react-server scripts/backfillGitHistory.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude 'src/lib/zip/readZip.totalLimit*.test.ts' --testTimeout=30000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:secrets": "playwright test --project=secrets",
    "coverage:merge": "tsx scripts/coverageMerge.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "hash-password": "node scripts/hashPassword.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@atomic-editor/editor": "0.6.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@erase2d/fabric": "^1.2.1",
    "@huggingface/transformers": "^4.2.0",
    "@mixmark-io/domino": "^2.2.0",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-codemirror": "^4.25.11",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "breadboard-fence": "file:vendor/breadboard-fence-0.9.0.tgz",
    "circuit-fence": "file:vendor/circuit-fence-0.8.0.tgz",
    "eruda": "^3.4.3",
    "fabric": "^7.4.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "fix-webm-duration": "^1.0.6",
    "heic-decode": "^2.1.0",
    "katex": "^0.16.47",
    "mdast-util-directive": "^3.1.0",
    "mermaid": "^11.16.0",
    "micromark-extension-directive": "^4.0.0",
    "next": "16.2.11",
    "node-tikzjax": "^1.0.5",
    "onnxruntime-node": "1.24.3",
    "onnxruntime-web": "^1.27.0",
    "pdfjs-dist": "^6.1.200",
    "perfboard-fence": "file:vendor/perfboard-fence-0.6.0.tgz",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "simple-git": "^3.36.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zxing-wasm": "3.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "monocart-coverage-reports": "2.13.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
