{
  "name": "ver2",
  "version": "0.23.86",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run copy:assets && npm run licenses && next dev",
    "build": "npm run copy:assets && npm run licenses && prisma generate && next build",
    "copy:assets": "node scripts/assets.mjs",
    "licenses": "generate-license-file",
    "backfill:embeddings": "tsx --conditions=react-server scripts/backfillEmbeddings.ts",
    "backfill:git": "tsx --conditions=react-server scripts/backfillGitHistory.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude 'src/lib/zip/readZip.totalLimit*.test.ts' --testTimeout=30000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:secrets": "playwright test --project=secrets",
    "coverage:merge": "tsx scripts/coverageMerge.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "hash-password": "node scripts/hashPassword.mjs",
    "postinstall": "prisma generate"
  },
